APP_NAME=Kakeibo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_URL=https://api.kakeibo963.online

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ロリポップのデータベース設定画面で発行されるホスト名・DB名・ユーザー名・パスワードに置き換える
DB_CONNECTION=mysql
DB_HOST=mysqlXXX.lolipop.jp
DB_PORT=3306
DB_DATABASE=LAxxxxxx_kakeibo
DB_USERNAME=LAxxxxxx
DB_PASSWORD=

# Sanctum SPA(Cookie)認証: SPAとAPIは別オリジン(サブドメイン)だが、
# SPA(kakeibo963.online)とAPI(api.kakeibo963.online)が別サブドメインなので、
# CSRF Cookieをフロントエンド側のJSからも読めるよう共通の親ドメインを指定する
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.kakeibo963.online
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kakeibo963.online"
MAIL_FROM_NAME="${APP_NAME}"

# フロントエンド(SPA)のオリジン
FRONTEND_URL=https://kakeibo963.online
SANCTUM_STATEFUL_DOMAINS=kakeibo963.online
